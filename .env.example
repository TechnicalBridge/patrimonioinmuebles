# =============================================================================
#  No lo copies a mano: corre
#      powershell -ExecutionPolicy Bypass -File .\preparar-env.ps1
#  que crea el .env desde este archivo y llena cada secreto con una clave al azar.
# =============================================================================
#  Los SECRETOS (ADMIN_PASSWORD y CIFRADO_LLAVE) van vacios a proposito: este
#  archivo es publico, y un valor escrito aqui lo podria leer cualquiera. Sin
#  ellos el servidor y docker compose no arrancan y dicen cual falta. Lo demas
#  tiene un valor de desarrollo.
# =============================================================================

# --- Lo basico --------------------------------------------------------------

# Puerto del sitio y de la API.
PORT=3001

# El primer usuario del panel interno, en /admin. Se crea solo si la base no
# tiene ningun usuario; despues, cambiar esto no cambia la clave de nadie.
# Para cambiarla despues: preparar-env.ps1 -Cambiar ADMIN_PASSWORD.
ADMIN_CORREO=admin@patrimonioinmuebles.cl
ADMIN_PASSWORD=

# Donde se guarda la base. Un archivo SQLite; si no existe, se crea con datos
# de demostracion la primera vez que arranca el servidor. Una base anterior se
# pone al dia sola al arrancar, sin perder sus datos.
# PATRIMONIO_DB=server/patrimonio.db

# La llave con que se cifran, en la base, la clave de la agencia y el secreto
# de sus avisos. No se guarda en la base: quien se lleve una copia del archivo
# no se lleva los secretos. Si la cambias, hay que volver a conectar la agencia.
CIFRADO_LLAVE=

# Los origenes que pueden usar la API desde otro sitio, separados por coma. Por
# omision ninguno: el panel se sirve desde el mismo origen y la agencia habla
# de servidor a servidor.
# CORS_ORIGENES=https://admin.ejemplo.cl


# --- La agencia de cobranza --------------------------------------------------
#
# No se configura aqui: se conecta desde el panel, en la pestaña Cobranza, con
# la direccion y la clave que te da la agencia. Ahi mismo Patrimonio se suscribe
# a sus avisos de pago y guarda el secreto con que vienen firmados.
