# =============================================================================
#  Copia este archivo como .env y cambia lo que necesites.
#      cp .env.example .env
# =============================================================================
#  Todo tiene un valor por omision que sirve para desarrollo, asi que el
#  proyecto arranca sin este archivo. Existe para no tener que buscar en el
#  codigo que se puede configurar.
# =============================================================================

# --- Lo basico --------------------------------------------------------------

# Puerto del sitio y de la API.
PORT=3001

# Clave del panel interno, en /admin.
# CAMBIALA antes de mostrarle esto a alguien.
ADMIN_PASSWORD=patrimonio

# Donde se guarda la base. Un archivo SQLite; si no existe, se crea con datos
# de demostracion la primera vez que arranca el servidor.
# PATRIMONIO_DB=server/patrimonio.db


# --- Entregarle la cartera morosa a una agencia de cobranza -----------------
#
# Sin estas tres variables Patrimonio funciona igual: la cartera se genera y
# se descarga como archivo, y alguien la entrega a mano.

# La direccion de la agencia (APOFYX, en este proyecto).
COBRANZA_URL=

# La clave de API que la agencia emitio para Patrimonio. Empieza con apx_
COBRANZA_CLAVE=

# El RUT de la agencia, para que la cartera diga a quien va dirigida.
COBRANZA_AGENCIA_RUT=


# --- Recibir los avisos de pago ---------------------------------------------
#
# Cuando alguien paga en la plataforma de pagos, el aviso vuelve hasta aca y
# marca el cargo. Viene firmado, y sin este secreto el endpoint /api/eventos
# esta APAGADO a proposito: un secreto escrito en el codigo no es un secreto.
#
# Lo entrega la agencia al registrar la direccion de Patrimonio:
#   python manage.py suscribir_cliente 76418902-7 http://localhost:3001/api/eventos
EVENTOS_SECRET=
